<Window x:Class="ClipForge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Title="ClipForge" Width="1460" Height="900" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen" AllowDrop="True"
        Drop="Window_Drop" DragOver="Window_DragOver">
    <Grid Background="{StaticResource Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="8" Background="{StaticResource Accent}" Margin="0,0,10,0">
                        <TextBlock Text="▶" Foreground="White" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ClipForge" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="v0.3.1 • quick editor" Style="{StaticResource MutedTextStyle}"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" Width="1" Background="{StaticResource Border}" Margin="18,2"/>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock x:Name="FileNameText" Text="Drop a video here" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="FileInfoText" Text="MP4, MKV, MOV, WebM and most FFmpeg/VLC formats" Style="{StaticResource MutedTextStyle}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Open Video" Click="Open_Click" Style="{StaticResource PrimaryButtonStyle}" MinWidth="112"/>
                    <Button Content="Reload" Click="Reload_Click" MinWidth="82"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main editor -->
        <Grid Grid.Row="1" Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="540"/>
                <ColumnDefinition Width="7"/>
                <ColumnDefinition Width="430" MinWidth="360"/>
            </Grid.ColumnDefinitions>

            <!-- Preview / timeline -->
            <Grid Grid.Column="0" Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Background="#030507" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="9" ClipToBounds="True">
                    <Grid>
                        <vlc:VideoView x:Name="VideoView">
                            <Grid Background="Transparent">
                                <Canvas x:Name="CropCanvas" Background="#02000000"
                                        MouseLeftButtonDown="CropCanvas_MouseLeftButtonDown"
                                        MouseMove="CropCanvas_MouseMove"
                                        MouseLeftButtonUp="CropCanvas_MouseLeftButtonUp"
                                        SizeChanged="CropCanvas_SizeChanged">
                                    <Rectangle x:Name="CropSelection" Visibility="Collapsed"
                                               Stroke="{StaticResource Accent}" StrokeThickness="3"
                                               Fill="#162388FF" IsHitTestVisible="False"/>
                                    <Rectangle x:Name="CropHandleTL" Visibility="Collapsed" Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="White" Stroke="{StaticResource Accent}" StrokeThickness="2" IsHitTestVisible="False"/>
                                    <Rectangle x:Name="CropHandleTR" Visibility="Collapsed" Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="White" Stroke="{StaticResource Accent}" StrokeThickness="2" IsHitTestVisible="False"/>
                                    <Rectangle x:Name="CropHandleBL" Visibility="Collapsed" Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="White" Stroke="{StaticResource Accent}" StrokeThickness="2" IsHitTestVisible="False"/>
                                    <Rectangle x:Name="CropHandleBR" Visibility="Collapsed" Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="White" Stroke="{StaticResource Accent}" StrokeThickness="2" IsHitTestVisible="False"/>
                                </Canvas>
                            </Grid>
                        </vlc:VideoView>

                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"
                                Background="#B5121925" BorderBrush="#803A4B61" BorderThickness="1" CornerRadius="5" Padding="8,4"
                                IsHitTestVisible="False">
                            <TextBlock Text="PREVIEW" Foreground="{StaticResource SecondaryText}" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,10,0,0" Padding="12,9">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Slider x:Name="SeekSlider" Grid.Row="0" Minimum="0" Maximum="1"
                                ValueChanged="SeekSlider_ValueChanged"
                                PreviewMouseLeftButtonDown="SeekSlider_PreviewMouseLeftButtonDown"
                                PreviewMouseLeftButtonUp="SeekSlider_PreviewMouseLeftButtonUp"
                                PreviewMouseDoubleClick="ResetSlider_DoubleClick"
                                ToolTip="Scrub position • Double-click to jump to the start"/>
                        <Grid Grid.Row="1" Margin="2,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="CurrentTimeText" Grid.Column="0" Text="0:00.000" Foreground="{StaticResource Accent}" FontWeight="SemiBold" FontFamily="Consolas"/>
                            <TextBlock x:Name="DurationText" Grid.Column="1" Text="0:00.000" HorizontalAlignment="Right" Foreground="{StaticResource SecondaryText}" FontFamily="Consolas"/>
                        </Grid>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                    <Button x:Name="PlayPauseButton" Content="Play" Click="PlayPause_Click" Style="{StaticResource PrimaryButtonStyle}" MinWidth="96"/>
                    <Button Content="−5 sec" Click="Back5_Click" MinWidth="82"/>
                    <Button Content="+5 sec" Click="Forward5_Click" MinWidth="82"/>
                    <Button Content="Mark Start" Click="MarkStart_Click" MinWidth="104"/>
                    <Button Content="Mark End" Click="MarkEnd_Click" MinWidth="104"/>
                </StackPanel>
            </Grid>

            <GridSplitter Grid.Column="1" Width="7" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="Transparent" ShowsPreview="True" Cursor="SizeWE"/>

            <!-- Controls -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="3,0,4,0">
                <StackPanel>
                    <!-- Trim -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Trim" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock x:Name="TrimText" Grid.Column="1" Text="0:00.000 → 0:00.000" HorizontalAlignment="Right" Style="{StaticResource MutedTextStyle}" FontFamily="Consolas"/>
                            </Grid>

                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="82"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Start" Foreground="{StaticResource SecondaryText}"/>
                                <Slider x:Name="StartSlider" Grid.Column="1" Minimum="0" Maximum="1"
                                        ValueChanged="TrimSlider_ValueChanged"
                                        PreviewMouseDoubleClick="ResetSlider_DoubleClick"
                                        ToolTip="Trim start • Double-click to reset to 0:00"/>
                                <TextBlock x:Name="StartValueText" Grid.Column="2" Text="0:00.000" HorizontalAlignment="Right" Foreground="{StaticResource SecondaryText}" FontFamily="Consolas"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="82"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="End" Foreground="{StaticResource SecondaryText}"/>
                                <Slider x:Name="EndSlider" Grid.Column="1" Minimum="0" Maximum="1" Value="1"
                                        ValueChanged="TrimSlider_ValueChanged"
                                        PreviewMouseDoubleClick="ResetSlider_DoubleClick"
                                        ToolTip="Trim end • Double-click to reset to the full video length"/>
                                <TextBlock x:Name="EndValueText" Grid.Column="2" Text="0:00.000" HorizontalAlignment="Right" Foreground="{StaticResource SecondaryText}" FontFamily="Consolas"/>
                            </Grid>
                            <Button Content="Reset Trim" Click="ResetTrim_Click" HorizontalAlignment="Left" Style="{StaticResource CompactButtonStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- Crop -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Crop &amp; Rotate" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12"/>

                            <TextBlock Text="Crop mode" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="CropModeCombo" SelectionChanged="CropMode_SelectionChanged" Margin="0,0,0,6">
                                <ComboBoxItem Content="None" IsSelected="True"/>
                                <ComboBoxItem Content="Draw Custom"/>
                                <ComboBoxItem Content="16:9 Center"/>
                                <ComboBoxItem Content="9:16 Center"/>
                                <ComboBoxItem Content="1:1 Center"/>
                                <ComboBoxItem Content="4:3 Center"/>
                            </ComboBox>
                            <TextBlock Text="Draw Custom: drag a rectangle directly over the video preview."
                                       Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="1,0,0,12"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Left" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="CropXBox" Text="0" ToolTip="Crop X" TextChanged="CropBox_TextChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Top" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="CropYBox" Text="0" ToolTip="Crop Y" TextChanged="CropBox_TextChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Width" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="CropWBox" Text="0" ToolTip="Crop width" TextChanged="CropBox_TextChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="6">
                                    <TextBlock Text="Height" Style="{StaticResource FieldLabelStyle}"/>
                                    <TextBox x:Name="CropHBox" Text="0" ToolTip="Crop height" TextChanged="CropBox_TextChanged"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Rotation" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="RotateCombo" Margin="0,0,0,5">
                                <ComboBoxItem Content="None" IsSelected="True"/>
                                <ComboBoxItem Content="90° Right"/>
                                <ComboBoxItem Content="90° Left"/>
                                <ComboBoxItem Content="180°"/>
                            </ComboBox>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="FlipHBox" Content="Flip horizontal"/>
                                <CheckBox x:Name="FlipVBox" Content="Flip vertical"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Audio -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Audio" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8"/>
                            <CheckBox x:Name="MuteBox" Content="Mute / remove audio" Checked="MuteBox_Changed" Unchecked="MuteBox_Changed"/>
                            <Grid Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="62"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="52"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Volume" Foreground="{StaticResource SecondaryText}"/>
                                <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="2" Value="1" TickFrequency="0.1"
                                        ValueChanged="VolumeSlider_ValueChanged"
                                        PreviewMouseDoubleClick="ResetSlider_DoubleClick"
                                        ToolTip="Preview/export volume • Double-click to reset to 100%"/>
                                <TextBlock x:Name="VolumeText" Grid.Column="2" Text="100%" HorizontalAlignment="Right" Foreground="{StaticResource SecondaryText}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Picture -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Picture" Style="{StaticResource SectionTitleStyle}"/>
                                <Border Grid.Column="1" Background="#14335926" BorderBrush="#4772D89A" BorderThickness="1"
                                        CornerRadius="5" Padding="7,3">
                                    <TextBlock Text="LIVE PREVIEW" Foreground="{StaticResource Success}" FontSize="11" FontWeight="Bold"/>
                                </Border>
                            </Grid>
                            <TextBlock Text="Picture adjustments are applied to the preview immediately. Double-click any slider to reset it."
                                       Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Brightness" Foreground="{StaticResource SecondaryText}"/>
                                <Slider x:Name="BrightnessSlider" Grid.Column="1" Minimum="-0.5" Maximum="0.5" Value="0"
                                        ValueChanged="PictureSlider_Changed"
                                        PreviewMouseDoubleClick="ResetSlider_DoubleClick"
                                        ToolTip="Brightness • Double-click to reset"/>
                                <TextBlock x:Name="BrightnessValueText" Grid.Column="2" Text="0%" HorizontalAlignment="Right" Foreground="{StaticResource SecondaryText}"/>
                            </Grid>
                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Contrast" Foreground="{StaticResource SecondaryText}"/>
                                <Slider x:Name="ContrastSlider" Grid.Column="1" Minimum="0.5" Maximum="1.8" Value="1"
                                        ValueChanged="PictureSlider_Changed"
                                        PreviewMouseDoubleClick="ResetSlider_DoubleClick"
                                        ToolTip="Contrast • Double-click to reset"/>
                                <TextBlock x:Name="ContrastValueText" Grid.Column="2" Text="100%" HorizontalAlignment="Right" Foreground="{StaticResource SecondaryText}"/>
                            </Grid>
                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Saturation" Foreground="{StaticResource SecondaryText}"/>
                                <Slider x:Name="SaturationSlider" Grid.Column="1" Minimum="0" Maximum="2" Value="1"
                                        ValueChanged="PictureSlider_Changed"
                                        PreviewMouseDoubleClick="ResetSlider_DoubleClick"
                                        ToolTip="Saturation • Double-click to reset"/>
                                <TextBlock x:Name="SaturationValueText" Grid.Column="2" Text="100%" HorizontalAlignment="Right" Foreground="{StaticResource SecondaryText}"/>
                            </Grid>
                            <Button Content="Reset Picture" Click="ResetPicture_Click" HorizontalAlignment="Left" Style="{StaticResource CompactButtonStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- Output -->
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,2">
                        <StackPanel>
                            <TextBlock Text="Output" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,12"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Resolution" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox x:Name="ResolutionCombo">
                                        <ComboBoxItem Content="Original" IsSelected="True"/>
                                        <ComboBoxItem Content="2160p (4K)"/>
                                        <ComboBoxItem Content="1440p"/>
                                        <ComboBoxItem Content="1080p"/>
                                        <ComboBoxItem Content="720p"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Frame rate" Style="{StaticResource FieldLabelStyle}"/>
                                    <ComboBox x:Name="FpsCombo">
                                        <ComboBoxItem Content="Original" IsSelected="True"/>
                                        <ComboBoxItem Content="60 FPS"/>
                                        <ComboBoxItem Content="30 FPS"/>
                                        <ComboBoxItem Content="24 FPS"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Encoder" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="EncoderCombo" Margin="0,0,0,10">
                                <ComboBoxItem Content="Automatic (H.264)" IsSelected="True"/>
                                <ComboBoxItem Content="NVIDIA H.264"/>
                                <ComboBoxItem Content="NVIDIA HEVC"/>
                                <ComboBoxItem Content="NVIDIA AV1"/>
                                <ComboBoxItem Content="CPU H.264"/>
                            </ComboBox>

                            <TextBlock Text="Quality" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox x:Name="QualityCombo" Margin="0,0,0,6">
                                <ComboBoxItem Content="Fastest"/>
                                <ComboBoxItem Content="Recommended" IsSelected="True"/>
                                <ComboBoxItem Content="Highest Quality"/>
                                <ComboBoxItem Content="Small File"/>
                            </ComboBox>
                            <CheckBox x:Name="FastCopyBox" IsChecked="True" Content="Smart Fast Copy when possible"/>
                            <TextBlock Text="Fast-copy trims are keyframe-based. Disable it when you need frame-accurate trim points."
                                       Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="1,1,0,10"/>

                            <Border Height="1" Background="{StaticResource Border}" Margin="0,1,0,10"/>

                            <TextBlock Text="Privacy" Style="{StaticResource FieldLabelStyle}"/>
                            <CheckBox x:Name="ScrubMetadataBox" Content="Scrub metadata / EXIF from exported video"/>
                            <TextBlock Text="Removes source container metadata such as title/comments, device/app tags, creation time, GPS/location tags and chapters where FFmpeg exposes them. This does not re-encode by itself, so it can still work with Smart Fast Copy."
                                       Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="1,1,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Status / export -->
        <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Margin="0,0,14,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock x:Name="StatusText" Grid.Row="0" Text="Ready. Drop a video anywhere in the window."
                               Foreground="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    <Grid Grid.Row="1" Margin="0,7,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                        <ProgressBar x:Name="ExportProgress" Grid.Column="0" Minimum="0" Maximum="100"/>
                        <TextBlock x:Name="ExportProgressText" Grid.Column="1" Text="" HorizontalAlignment="Right" Style="{StaticResource MutedTextStyle}" FontFamily="Consolas"/>
                    </Grid>
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="CancelButton" Content="Cancel" Click="CancelExport_Click" IsEnabled="False" MinWidth="92"/>
                    <Button x:Name="ExportButton" Content="EXPORT" Click="Export_Click" Style="{StaticResource PrimaryButtonStyle}" MinWidth="128" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
